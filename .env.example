# POS Cloud — deployment secrets template (PHASE 32 isolated stack).
# Copy to .env and fill real secrets. .env is gitignored — never commit it.
# ⛔ Do NOT reuse ERP/Owner credentials here.

# --- PostgreSQL (dedicated POS database) ---
POS_POSTGRES_DB=POSCloudDb
POS_POSTGRES_USER=poscloud
POS_POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# --- JWT ---
POS_JWT_KEY=CHANGE_ME_64_RANDOM_CHARS_FOR_POS_JWT_SIGNING

# --- Host hardening ---
# The hostname/IP clients will use (e.g. the VPS public IP or domain).
# Production fails-fast while this is unset.
POS_ALLOWED_HOSTS=CHANGE_ME_TO_VPS_HOST_OR_IP

# --- Web origin (CORS) ---
# The origin the Flutter Web UI is served from, e.g. http://VPS_IP:8104
POS_WEB_ORIGIN=CHANGE_ME_http://VPS_IP:8104

# --- Host ports (verify they are free on the VPS before choosing) ---
POS_API_PORT=8103
POS_WEB_PORT=8104

# --- Image tag for the built stack ---
POS_VERSION=phase32
