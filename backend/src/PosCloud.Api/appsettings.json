{
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=poscloud;Username=postgres;Password=postgres",
    "Postgres": "Host=localhost;Database=poscloud;Username=postgres;Password=postgres",
    "Sqlite": "Data Source=poscloud.db"
  },
  "Jwt": {
    "Key": "__REQUIRED_VIA_ENV_Jwt__Key__SET_JWT_KEY_OR_USE_DEVELOPMENT__",
    "Issuer": "PosCloud",
    "Audience": "PosCloud",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "UseInMemory": false,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
